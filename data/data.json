  "skills": [
    {
      "name": "Help Guide",
      "cost": 20,
      "description": "Detailed explanations and advice will be displayed. Cannot be removed after purchase.",
      "hidden_info": "Some explanations and advice will remain accessible for browsing after transport.",
      "has_levels": false
    },
    {
      "name": "Plunder",
      "cost": 80,
      "description": "Steal target’s skills. The levels of the stolen skills will remain the same they were originally. You do not need to designate which skill you want to steal. The stolen skill will be returned to its original owner upon the death of the user.",
      "hidden_info": "The user’s life span will be reduced by 4% x the level of the stolen skills, and that total amount will be transferred to the target. This formula treats skills without levels as Level 5.",
      "has_levels": false
    },
    {
      "name": "Copy",
      "cost": 100,
      "description": "Copy a skill from the target. Does not affect the target’s skills. However, you must know both the name and level of the skill you want to copy.",
      "hidden_info": "The copied skill will be reduced to Level 1 and its status will be changed to Sealed. The status effect will be removed upon learning how to use the copied skill from its original user. Cannot copy skills that don’t have a level.",
      "has_levels": false
    },
    {
      "name": "2x EXP",
      "cost": 50,
      "description": "Experience gained from combat and training is doubled.",
      "hidden_info": "The number of Experience Points required to level up will be increased tenfold.",
      "has_levels": false
    },
    {
      "name": "10x EXP",
      "cost": 120,
      "description": "Experience gained from combat and training is increased tenfold.",
      "hidden_info": "The number of Experience Points required to level up will be increased tenfold.",
      "has_levels": false
    },
    {
      "name": "Heroic Aptitude",
      "cost": 80,
      "description": "Grants you the innate aptitude to become a Hero through training and effort.",
      "hidden_info": "Your chances of getting involved in trouble are increased, and you will often end up in life-threatening situations.",
      "has_levels": false
    },
    {
      "name": "Magic Aptitude: Earth",
      "cost": 10,
      "description": "You become able to learn Earth magic.",
      "hidden_info": "Humans cannot learn Earth magic without this skill. Elves can learn Earth magic even without this skill, but acquiring this skill will allow them to use stronger magic.",
      "has_levels": false
    },
    {
      "name": "Magic Aptitude: Fire",
      "cost": 10,
      "description": "You become able to learn Fire magic.",
      "hidden_info": "Humans cannot learn Fire magic without this skill. Elves can learn Fire magic even without this skill, but acquiring this skill will allow them to use stronger magic.",
      "has_levels": false
    },
    {
      "name": "Magic Aptitude: Light",
      "cost": 10,
