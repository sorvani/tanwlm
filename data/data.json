    {
      "name": "Mana Capacity: Ultimate",
      "cost": 80,
      "description": "Grants you an overwhelming amount of mana.",
      "hidden_info": "Your physical strength and endurance will be greatly reduced. Controlling your mana will also become very difficult.",
      "has_levels": false
    },
    {
      "name": "Charm",
      "cost": 50,
      "description": "You become very alluring to the opposite sex and mesmerize them. Your outward appearance will not change.",
      "hidden_info": "Targets under the influence of Charm will become very controlling and possessive and will want to keep you to themselves. You are unable to designate a target for this skill.",
      "has_levels": false
    },
    {
      "name": "Robust",
      "cost": 10,
      "description": "Your body becomes much more resilient and durable.",
      "hidden_info": "You will become resistant to injury and diseases. However, this is a different world, so there may be pathogens that didn’t exist in your previous world.",
      "has_levels": true
    },
    {
      "name": "Attractive Appearance",
      "cost": 10,
      "description": "You gain a very attractive outward appearance.",
      "hidden_info": "Not recommended for Elves due to their natural beauty. Humans who are allured by appearance alone may cause trouble.",
      "has_levels": false
    },
    {
